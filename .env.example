# ─────────────────────────────────────────────
#  MathModern — VPS Docker deployment (.env)
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# PostgreSQL password — придумай любой, должен совпадать в обеих строках
DB_PASSWORD="сюда_пароль_бд"

# Connection string для Prisma — меняй только пароль (после двоеточия)
DATABASE_URL="postgresql://mathmodern:сюда_пароль_бд@db:5432/mathmodern"

# Случайная строка для шифрования сессий — минимум 32 символа
# Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET="сюда_случайную_строку_минимум_32_символа"

# Публичный адрес твоего сайта (IP или домен + порт)
NEXTAUTH_URL="http://сюда_ip_вашего_vps:8081"
NEXT_PUBLIC_APP_URL="http://сюда_ip_вашего_vps:8081"

# ─────────────────────────────────────────────
#  API v1 — для AI-ассистента и внешних систем
# ─────────────────────────────────────────────
# Секретный ключ для API. Сгенерировать: openssl rand -hex 32
API_SECRET_KEY="сюда_секретный_ключ_для_api"
